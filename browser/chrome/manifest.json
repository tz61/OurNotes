{
  "manifest_version": 3,
  "name": "OurNotes Connector",
  "version": "0.1.14",
  "description": "Save the page you are reading, with its PDF, to OurNotes.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Save to OurNotes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Save the page to OurNotes"
    }
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:23120/*"]
}
