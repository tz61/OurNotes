# systemd unit for the OurNotes sync server. See docs/server.md.
#
#   sudo useradd --system --home-dir /var/lib/ournotesd --shell /usr/sbin/nologin ournotesd
#   sudo install -m 644 packaging/ournotesd.service /etc/systemd/system/
#   sudo systemctl enable --now ournotesd
#
# Adjust ExecStart in a drop-in (systemctl edit ournotesd), e.g. to listen on all
# interfaces with built-in TLS (see docs/server.md for LoadCredential=).

[Unit]
Description=OurNotes sync server
Documentation=https://github.com/ournotes/ournotes/blob/main/docs/server.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ournotesd
Group=ournotesd
# Listens on localhost only: put a TLS reverse proxy in front of it.
ExecStart=/usr/local/bin/ournotesd serve --data /var/lib/ournotesd --host 127.0.0.1 --port 8642 --trusted-proxy 127.0.0.1
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

StateDirectory=ournotesd
StateDirectoryMode=0700
UMask=0077

# Hardening
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
